NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./techcpr.db

# Stripe test mode while validating the project.
# Switch NODE_ENV=production only after replacing these with live values
# and configuring the production webhook endpoint.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Use a unique random value of at least 16 characters.
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_SESSION_TTL_MS=28800000

MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=techcpr-api
MIKROTIK_PASSWORD=replace_with_router_api_password
MIKROTIK_CUSTOMER_PROFILE=customer

PRICE_DAY_CENTS=1000
PRICE_WEEK_CENTS=2500
PRICE_MONTH_CENTS=5000

BACKUP_RETENTION_DAYS=30
# BACKUP_DIRECTORY=C:\TechCPR-Backups
# LOG_DIRECTORY=C:\TechCPR-Logs

MAINTENANCE_AUTO_REPAIR=true
MAINTENANCE_INTERVAL_MS=300000
MAINTENANCE_MAX_REPAIRS=10
