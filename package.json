{
  "name": "techcpr-wifi-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Stripe-powered WiFi captive portal with MikroTik HotSpot provisioning.",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/patch-node-routeros.js && node scripts/preflight.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "preflight": "node scripts/preflight.js",
    "security:check": "node scripts/security-check.js",
    "release:check": "node scripts/release-check.js",
    "backup": "node scripts/backup-db.js",
    "test:mikrotik": "node test-mikrotik.js",
    "test:provision": "node test-provision.js",
    "test:webhook-replay": "node scripts/test-webhook-replay.js",
    "postinstall": "node scripts/patch-node-routeros.js",
    "sync:check": "node scripts/check-sync.js"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-routeros": "^1.6.9",
    "sqlite3": "^6.0.1",
    "stripe": "^22.1.1"
  }
}
